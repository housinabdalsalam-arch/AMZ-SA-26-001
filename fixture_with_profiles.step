ISO-10303-21;
HEADER;
FILE_DESCRIPTION((
  'My fixture for drawing AMZ-SA-26-001, with the four profiles in place.',
  'I modelled the jaws closed. Each pair of side jaws is a pneumatic',
  'parallel gripper. The end jaws run on slides under the plate, their',
  'racks turn one pinion, and one air cylinder moves them. Units: mm.'),'2;1');
FILE_NAME('fixture_with_profiles.step','2026-11-08T21:07:23',('Abdalsalam Housin'),(
    ''),'Open CASCADE STEP processor 7.8','FreeCAD','Unknown');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
